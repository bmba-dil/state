{
  "name": "@state/opencode-plugin",
  "version": "0.1.0",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "bundle": "bun build src/index.ts --outdir=dist --format=esm --target=bun --external @opencode-ai/plugin --external @opencode-ai/sdk --external effect --external zod --external @opentui/core --external @opentui/solid --external solid-js",
    "dist": "tsc && bun run bundle",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.20",
    "@opencode-ai/sdk": ">=1.14.20",
    "effect": "4.0.0-beta.48",
    "zod": "4.1.8",
    "@opentui/core": "0.1.99",
    "@opentui/solid": "0.1.99",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "typescript": "5.8.2",
    "@tsconfig/node22": "22.0.2",
    "@types/node": "22.13.9",
    "@types/bun": "1.3.12",
    "bun": "1.3.13"
  }
}
